{
  "name": "trading_landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check app/layout.tsx app/page.tsx app/robots.ts app/sitemap.ts app/manifest.ts app/opengraph-image.tsx app/providers lib scripts/verify-runtime.mjs vercel.json package.json",
    "check": "bun run lint && bun run typecheck",
    "verify:runtime": "node scripts/verify-runtime.mjs"
  },
  "dependencies": {
    "convex": "^1.45.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
